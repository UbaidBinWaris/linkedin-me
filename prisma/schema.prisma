// Prisma schema for LinkedIn Comment Bot
// Run: npx prisma migrate dev --name init
//  or: npx prisma db push   (faster for development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  READY_TO_MESSAGE
  MESSAGED
  FOLLOW_UP_DUE
  REPLIED
  CLOSED
}

enum ContactTag {
  RECRUITER
  DEVELOPER
  FOUNDER
}

// ─────────────────────────────────────────────────────────────────
//  CommentedPost — permanent record of every comment attempt
//
//  postId is the canonical dedup key (19-digit LinkedIn snowflake ID
//  or the full URL when no ID can be extracted).
//  The UNIQUE constraint at database level is the final safety net —
//  even if application logic races, PostgreSQL will reject a second
//  insert for the same postId with a unique-constraint error.
// ─────────────────────────────────────────────────────────────────
model CommentedPost {
  id          Int      @id @default(autoincrement())
  postId      String   @unique          // 19-digit activity ID (dedup key)
  postUrl     String?                   // full LinkedIn URL (for debugging)
  authorName  String?                   // author name at time of comment
  commentText String?                   // AI-generated comment text
  commentedAt DateTime @default(now())  // UTC timestamp

  @@index([postId])
  @@index([commentedAt])
  @@map("commented_posts")
}

model Contact {
  id              String        @id @default(uuid())
  name            String
  role            String
  company         String
  location        String
  linkedinUrl     String        @unique
  notes           String?
  status          ContactStatus @default(NEW)
  tag             ContactTag?
  firstMessage    String?
  followUpMessage String?
  lastMessageAt   DateTime?
  followUpDueAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([followUpDueAt])
  @@index([createdAt])
  @@map("contacts")
}
