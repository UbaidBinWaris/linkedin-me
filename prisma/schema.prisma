// Prisma schema for LinkedIn Comment Bot
// Run: npx prisma migrate dev --name init
//  or: npx prisma db push   (faster for development)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum ContactStatus {
  NEW
  READY_TO_MESSAGE
  MESSAGED
  FOLLOW_UP_DUE
  REPLIED
  CLOSED
}

enum ContactTag {
  RECRUITER
  DEVELOPER
  FOUNDER
}

enum DraftStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum DraftType {
  POST
  COMMENT
}

// ─────────────────────────────────────────────────────────────────
//  CommentedPost — permanent record of every comment attempt
// ─────────────────────────────────────────────────────────────────
model CommentedPost {
  id          Int      @id @default(autoincrement())
  postId      String   @unique          // 19-digit activity ID (dedup key)
  postUrl     String?                   // full LinkedIn URL (for debugging)
  authorName  String?                   // author name at time of comment
  commentText String?                   // AI-generated comment text
  commentedAt DateTime @default(now())  // UTC timestamp

  @@index([postId])
  @@index([commentedAt])
  @@map("commented_posts")
}

model Contact {
  id              String        @id @default(uuid())
  name            String
  role            String
  company         String
  location        String
  linkedinUrl     String        @unique
  notes           String?
  status          ContactStatus @default(NEW)
  tag             ContactTag?
  firstMessage    String?
  followUpMessage String?
  lastMessageAt   DateTime?
  followUpDueAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([followUpDueAt])
  @@index([createdAt])
  @@map("contacts")
}

model LinkedInProfile {
  id            String   @id @default(uuid())
  linkedinUrl   String   @unique
  fullName      String?
  headline      String?
  about         String?
  followers     Int?
  connections   Int?
  location      String?
  scrapedAt     DateTime @default(now())
  
  posts         LinkedInPost[]
  
  @@map("linkedin_profiles")
}

model LinkedInPost {
  id              String            @id @default(uuid())
  postId          String?           @unique
  postUrl         String?
  profileId       String?
  profile         LinkedInProfile?  @relation(fields: [profileId], references: [id])
  authorName      String?
  authorHeadline  String?
  authorFollowers Int?
  postText        String?
  postType        String?
  reactions       Int?              @default(0)
  comments        Int?              @default(0)
  reposts         Int?              @default(0)
  hashtags        String[]          @default([])
  mentions        String[]          @default([])
  language        String?           @default("en")
  industry        String?
  topic           String?
  sentimentScore  Float?
  viralScore      Float?
  postedAt        DateTime?
  scrapedAt       DateTime          @default(now())
  
  commentsList    LinkedInComment[]
  
  @@index([postId])
  @@index([topic])
  @@index([viralScore])
  @@map("linkedin_posts")
}

model LinkedInComment {
  id            String       @id @default(uuid())
  postId        String
  post          LinkedInPost @relation(fields: [postId], references: [id])
  commenterName String?
  commenterUrl  String?
  commentText   String?
  likes         Int?         @default(0)
  sentiment     String?
  emotion       String?
  intent        String?
  qualityScore  Float?
  hasQuestion   Boolean      @default(false)
  hasCTA        Boolean      @default(false)
  isSpam        Boolean      @default(false)
  createdAt     DateTime?    @default(now())
  
  @@index([postId])
  @@index([qualityScore])
  @@map("linkedin_comments")
}

// ─────────────────────────────────────────────────────────────────
//  PostDraft — Human-in-the-Loop review portal queue
//  Strict safety: AI agents produce DRAFT state records. Publishing
//  triggers ONLY when approved explicitly by the user.
// ─────────────────────────────────────────────────────────────────
model PostDraft {
  id             String      @id @default(uuid())
  type           DraftType   @default(COMMENT)
  targetPostId   String?
  targetPostUrl  String?
  authorName     String?
  content        String
  style          String?
  predictedScore Float?
  status         DraftStatus @default(DRAFT)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@map("post_drafts")
}

model CompetitorTrack {
  id           String   @id @default(uuid())
  name         String
  linkedinUrl  String   @unique
  headline     String?
  avgReactions Float?   @default(0)
  avgComments  Float?   @default(0)
  topTopics    String[] @default([])
  lastAnalyzed DateTime @default(now())

  @@map("competitor_tracks")
}

model ViralPattern {
  id             String   @id @default(uuid())
  topic          String
  contentType    String
  bestPostingHour Int?
  bestDayOfWeek  Int?
  avgEngagement  Float
  sampleSize     Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@map("viral_patterns")
}

model AgentMemory {
  id         String   @id @default(uuid())
  category   String   // e.g. "writing_style", "successful_hook", "failed_angle"
  key        String
  value      String
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())

  @@index([category])
  @@map("agent_memories")
}

model RawSnapshot {
  id          String   @id @default(uuid())
  sourceType  String
  sourceUrl   String
  htmlContent String
  createdAt   DateTime @default(now())
  
  @@map("raw_snapshots")
}

